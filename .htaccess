# Autocar Service - sito vetrina (25/09/2026)
# Ogni blocco e' dentro <IfModule>: se il modulo manca, viene ignorato invece di dare errore 500.

# --- un solo indirizzo: https, senza www ---
<IfModule mod_rewrite.c>
  RewriteEngine On
  # in locale (Laragon: localhost, 127.0.0.1, *.test) niente redirect, se no si finisce sul sito online
  RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1|[a-z0-9.-]+\.test)(:[0-9]+)?$ [NC]
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://autocar-service.it%{REQUEST_URI} [R=301,L]
</IfModule>

# --- pagina 404 con la grafica del sito ---
ErrorDocument 404 /404.html

# --- compressione ---
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json image/svg+xml font/woff2
</IfModule>

# --- cache: le risorse con ?v= nel nome cambiano indirizzo a ogni aggiornamento, quindi possono restare in cache a lungo ---
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType video/mp4 "access plus 1 year"
</IfModule>

# --- intestazioni di sicurezza (non toccano il funzionamento del sito) ---
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # il sito si puo' mostrare in un riquadro solo dentro se stesso e nell'anteprima "dal vivo" del portfolio di Massimo
  # (prima c'era X-Frame-Options SAMEORIGIN, che bloccava anche l'anteprima)
  Header always set Content-Security-Policy "frame-ancestors 'self' https://massimo-franco.netlify.app https://massimo-franco.pages.dev http://localhost http://massimo-franco-app.test"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# --- niente elenco delle cartelle ---
Options -Indexes
